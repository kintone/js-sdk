{
  "name": "@kintone/eslint-plugin",
  "version": "0.2.0",
  "description": "An ESLint plugin for kintone customization and plugin development.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "kintone"
  ],
  "homepage": "https://github.com/kintone/js-sdk/tree/main/packages/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/kintone/js-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kintone/js-sdk.git",
    "directory": "packages/eslint-plugin"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Cybozu, Inc.",
    "url": "https://cybozu.co.jp"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
  "files": [
    "CHANGELOG.md",
    "lib"
  ],
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "tsc --build ./tsconfig.build.json",
    "clean": "rimraf lib",
    "fix": "pnpm lint --fix",
    "lint": "eslint ./ --max-warnings 0",
    "start": "run-s clean 'build --watch'",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@typescript-eslint/utils": "8.72.1"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "26.1.0",
    "@types/node": "22.20.5",
    "@typescript-eslint/rule-tester": "8.72.1",
    "eslint": "10.13.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.5",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=9.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
