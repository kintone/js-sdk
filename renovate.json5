{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    ":ignoreModulesAndTests",
    ":label(renovate)",
    ":timezone(Asia/Tokyo)",
    "group:monorepos",
    ":widenPeerDependencies",
    ":prImmediately",
    ":dependencyDashboard",
    ":prConcurrentLimitNone",
  ],
  minimumReleaseAge: "14 days",
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
  ],
  npm: {
    extends: [
      ":automergePatch",
      ":noUnscheduledUpdates",
      ":separatePatchReleases",
      "helpers:disableTypesNodeMajor",
    ],
    schedule: ["after 9pm every weekday"],
    rangeStrategy: "bump",
    postUpdateOptions: ["pnpmDedupe"],
    packageRules: [
      {
        // set `chore` to the commit for updating packages
        matchPackageNames: ["*"],
        semanticCommitType: "chore",
      },
      {
        matchDepTypes: ["dependencies", "peerDependencies"],
        semanticCommitType: "fix",
      },
      {
        groupName: "ESLint and Prettier",
        matchPackageNames: [
          "eslint",
          "prettier",
          "/^eslint-config-/",
          "/^eslint-plugin-/",
          "@cybozu/eslint-config",
        ],
      },
      {
        // automerge minor updates of devDependencies
        matchPackageNames: ["*"],
        matchDepTypes: ["devDependencies"],
        matchUpdateTypes: ["minor"],
        automerge: true,
      },
      {
        description: "disable package.json > engines update",
        matchDepTypes: ["engines"],
        enabled: false,
      },
    ],
  },
  packageRules: [
    {
      description: "Renovate cannot enforce minimumReleaseAge for these update types",
      matchUpdateTypes: [
        "lockFileMaintenance",
        "replacement",
        "pin",
        "bump",
        "lockfileUpdate",
        "rollback",
      ],
      minimumReleaseAge: null,
    },
    {
      // runtime dependencies use bump strategy (update pinned versions)
      matchDepTypes: ["dependencies"],
      rangeStrategy: "bump",
    },
    {
      // group transitive-duplicate-risk deps to update together
      groupName: "axios and related deps",
      matchPackageNames: ["axios", "form-data"],
      matchDepTypes: ["dependencies"],
    },
    {
      groupName: "openapi ecosystem deps",
      matchPackageNames: [
        "openapi-fetch",
        "openapi-typescript",
        "openapi-typescript-helpers",
      ],
      matchDepTypes: ["dependencies"],
    },
    {
      groupName: "ajv ecosystem deps",
      matchPackageNames: ["ajv", "ajv-formats"],
      matchDepTypes: ["dependencies"],
    },
    {
      // Third party actions should be pinned with digest
      matchDepTypes: ["action"],
      matchPackageNames: ["!actions/{/,}**", "!cybozu/{/,}**"],
      pinDigests: true,
    },
  ],
}
